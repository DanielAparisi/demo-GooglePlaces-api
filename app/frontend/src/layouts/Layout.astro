---
import '../styles/global.css';

interface Props {
  title?: string;
}
const { title = 'Lead Generator · Google Places' } = Astro.props;
---
<!doctype html>
<html lang="es" class="bg-slate-950 antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen text-slate-200">
    <slot />
  </body>
</html>
