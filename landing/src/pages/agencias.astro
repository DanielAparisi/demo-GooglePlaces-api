---
import Base from '../layouts/Base.astro';
import Check from '../components/Check.astro';
import Faq from '../components/Faq.astro';
import { PLANES_LISTAS, SITIO, mailLink, waLink } from '../config';

const pedirMuestra = waLink(
  'Hola, tengo una agencia y me gustaría una muestra gratis de 10 leads. Sector: ___ · Ciudad: ___',
);

const columnas = ['Negocio', 'Sector', 'Ciudad', 'Teléfono', 'Email', 'Redes', 'Web actual', 'Oportunidad'];
// Datos inventados: solo enseñan el formato
const filas = [
  ['Taller Ejemplo', 'Taller mecánico', 'Murcia', 'Móvil', '✓', 'Instagram', 'No tiene', '82 · Alta'],
  ['Reformas Modelo', 'Reformas', 'Cartagena', 'Móvil', '—', 'Facebook', 'No tiene', '74 · Alta'],
  ['Fisio Demo', 'Fisioterapia', 'Molina', 'Fijo', '✓', 'Instagram', 'Solo redes', '61 · Media'],
];

const porque = [
  { t: 'Negocios sin web', d: 'Filtramos los que no tienen página propia: justo los que necesitan una agencia.' },
  { t: 'Puntuación de oportunidad', d: 'Cada lead lleva una nota de 0 a 100 y el motivo: sin web, móvil para WhatsApp, sector de ticket alto…' },
  { t: 'Frescos y sin repetir', d: 'Cada mes recibes leads nuevos. Nunca te enviamos dos veces el mismo negocio.' },
  { t: 'Segmentados a tu medida', d: 'Por sector y ciudad, barrio o provincia. Y si quieres, solo los que tienen móvil o email.' },
];

const faq = [
  { p: '¿De dónde salen los datos?', r: 'De fichas públicas de negocios en Google Maps, enriquecidas con los datos de contacto que el propio negocio publica en su web o redes.' },
  { p: '¿En qué formato los recibo?', r: 'Un CSV que se abre directamente en Excel o Google Sheets y se importa en cualquier CRM.' },
  { p: '¿Hay permanencia?', r: 'No. Es una suscripción mensual que puedes cancelar cuando quieras.' },
  { p: '¿Qué significa la exclusividad del plan Premium?', r: 'Los leads que recibes no se venden a ninguna otra agencia, nunca.' },
  { p: '¿Puedo probar antes de pagar?', r: 'Sí: te enviamos gratis 10 leads de tu sector y ciudad para que veas la calidad.' },
];
---
<Base
  titulo={`Listas de negocios locales para agencias · ${SITIO.marca}`}
  descripcion="Listas mensuales de negocios locales sin web, segmentadas por sector y ciudad, con teléfono, email, redes y puntuación de oportunidad. Muestra gratis de 10 leads."
  seccion="agencias"
>
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 h-[30rem] bg-linear-to-b from-brand-50 to-transparent"></div>
    <div class="contenedor max-w-4xl space-y-6 py-14 text-center sm:py-20">
      <p class="eyebrow">Para agencias de diseño web, marketing y SEO</p>
      <h1 class="text-4xl font-semibold tracking-tight text-balance text-tinta sm:text-5xl">
        Clientes potenciales listos para llamar, cada mes
      </h1>
      <p class="mx-auto max-w-2xl text-lg leading-relaxed text-slate-600">
        Negocios locales sin web de tu sector y tu ciudad, con teléfono, email y redes. Tú dedicas el tiempo a
        cerrar ventas, no a buscar en Google Maps.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href={pedirMuestra} class="btn btn-primario" target="_blank" rel="noopener">Pedir muestra gratis (10 leads)</a>
        <a href="#planes" class="btn btn-secundario">Ver planes</a>
      </div>
    </div>
  </section>

  <!-- Formato -->
  <section class="contenedor pb-14 sm:pb-20">
    <div class="overflow-hidden rounded-card border border-slate-200 bg-white shadow-card">
      <div class="flex items-center justify-between border-b border-slate-200 px-5 py-3">
        <p class="text-sm font-medium text-tinta">lista-talleres-murcia.csv</p>
        <p class="text-xs text-slate-500">Datos de ejemplo</p>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full min-w-[44rem] text-left text-sm">
          <thead class="bg-slate-50 text-xs text-slate-500">
            <tr>{columnas.map((c) => <th scope="col" class="px-4 py-2.5 font-medium">{c}</th>)}</tr>
          </thead>
          <tbody class="divide-y divide-slate-100 text-slate-700">
            {filas.map((f) => (
              <tr>{f.map((v, i) => <td class:list={['px-4 py-2.5', i === 0 && 'font-medium text-tinta', i === 7 && 'tabular-nums']}>{v}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white py-14 sm:py-20">
    <div class="contenedor">
      <div class="max-w-2xl space-y-2">
        <p class="eyebrow">Qué las hace distintas</p>
        <h2 class="titulo-seccion">No es otra base de datos genérica</h2>
      </div>
      <div class="mt-10 grid gap-x-8 gap-y-6 sm:grid-cols-2">
        {porque.map((p) => (
          <div class="flex gap-3">
            <Check />
            <div>
              <h3 class="font-semibold text-tinta">{p.t}</h3>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">{p.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Planes -->
  <section id="planes" class="contenedor scroll-mt-20 py-14 sm:py-20">
    <div class="mx-auto max-w-2xl space-y-2 text-center">
      <p class="eyebrow">Planes</p>
      <h2 class="titulo-seccion">Suscripción mensual, sin permanencia</h2>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-3">
      {PLANES_LISTAS.map((p) => (
        <div class:list={[
          'relative flex flex-col rounded-card border bg-white p-6 shadow-card',
          p.destacado ? 'border-brand-500 ring-1 ring-brand-500' : 'border-slate-200',
        ]}>
          {p.destacado && (
            <span class="absolute -top-3 left-6 rounded-full bg-brand-600 px-2.5 py-0.5 text-xs font-semibold text-white">Recomendado</span>
          )}
          <h3 class="font-semibold text-tinta">{p.nombre}</h3>
          <p class="mt-3 flex items-baseline gap-1">
            <span class="text-4xl font-semibold tracking-tight text-tinta tabular-nums">{p.precio} €</span>
            <span class="text-sm text-slate-500">/mes</span>
          </p>
          <p class="mt-1 text-sm text-slate-600">{p.leads} leads nuevos al mes</p>
          <ul class="mt-6 flex-1 space-y-2.5 text-sm text-slate-700">
            {p.extras.map((e) => <li class="flex gap-2"><Check />{e}</li>)}
          </ul>
          <a
            href={waLink(`Hola, me interesa el plan ${p.nombre} de listas de leads.`)}
            class:list={['btn mt-6 w-full', p.destacado ? 'btn-primario' : 'btn-secundario']}
            target="_blank"
            rel="noopener"
          >
            Empezar con {p.nombre}
          </a>
        </div>
      ))}
    </div>
    <p class="mt-6 text-center text-sm text-slate-500">
      ¿Necesitas otro volumen? <a class="font-medium text-brand-700 hover:underline" href={mailLink('Lista de leads a medida')}>Pide un pedido a medida</a>.
    </p>
  </section>

  <section class="contenedor max-w-3xl pb-14 sm:pb-20">
    <h2 class="titulo-seccion mb-6">Preguntas frecuentes</h2>
    <Faq preguntas={faq} />
  </section>

  <section class="contenedor pb-16 sm:pb-24">
    <div class="rounded-card bg-brand-900 px-6 py-12 text-center sm:px-12">
      <h2 class="text-2xl font-semibold tracking-tight text-balance text-white sm:text-3xl">Prueba gratis con 10 leads de tu sector</h2>
      <p class="mx-auto mt-3 max-w-xl text-brand-100">Dinos sector y ciudad y te los enviamos hoy mismo. Sin tarjeta y sin compromiso.</p>
      <a href={pedirMuestra} class="btn mt-8 bg-white text-brand-900 hover:bg-brand-50" target="_blank" rel="noopener">Pedir muestra gratis</a>
    </div>
  </section>
</Base>
